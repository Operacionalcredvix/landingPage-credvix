# ==================================================
# CREDVIX V2 - PRODUCAO
# Apache / Hostinger
# ==================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Bloqueia o antigo atalho publico do Farol CRM.
    # Funciona mesmo se farol.html continuar no servidor.
    RewriteRule ^farol\.html$ - [R=404,L,NC]

    # Redirecionamentos do site legado.
    # Temporarios (302) para facilitar eventual rollback.
    RewriteRule ^lojas\.html$ /lojas [R=302,L,NC]
    RewriteRule ^vagas\.html$ /vagas [R=302,L,NC]

    # Preserva arquivos e diretorios existentes.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # React Router: todas as rotas da SPA.
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"

    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>